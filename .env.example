# Server
PORT=3000
NODE_ENV=development

# Google Gemini API key (optional). Without it the AI chatbot returns built-in guidance.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: directory for the JSON database file.
# On Render with a persistent disk mounted at /var/data, set DATA_DIR=/var/data
DATA_DIR=

# Public URL of the deployment (optional)
APP_URL=http://localhost:3000
